# =============================================================================
#  SECRETOS Y CONFIGURACIÓN LOCAL
# =============================================================================

# --- Configuración local de la app -------------------------------------------
application-local.properties
application-local.yml
application-local.yaml
application-secrets.*
application-*-local.*

# --- Variables de entorno ----------------------------------------------------
.env
.env.*
!.env.example

# --- Certificados, llaves y credenciales -------------------------------------
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.crt
*.cer
credentials.json
service-account*.json
gcp-*.json

# --- Plantillas ---------------------------------------------------------------
# Estas NO tienen secretos, solo placeholders. Se recomienda commitearlas
# para que el proyecto sea reproducible. Descomentar si preferís ocultarlas.
application-local.properties.example
escenario.md


